<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IrisTrainTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="files\iris.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="files\iris.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="IrisTrainTest.cs" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="libtorch-cpu-linux-x64" Version="2.5.1" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
	  <PackageReference Include="libtorch-cpu-win-x64" Version="2.5.1" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
	  <PackageReference Include="libtorch-cpu-osx-x64" Version="2.5.1" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
	  <PackageReference Include="TorchVision" Version="0.105.1" />
	  <PackageReference Include="xunit" Version="2.9.3" />
	  <PackageReference Include="xunit.runner.utility" Version="2.9.3" />
	  <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\anndotnet.core\anndotnet.core.csproj" />
  </ItemGroup>

</Project>
